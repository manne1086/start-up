# Local Postgres (docker-compose). On Render this is set automatically
# from the linked database via render.yaml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ventureforge
REDIS_URL=redis://localhost:6379/0
GROQ_API_KEY=
TAVILY_API_KEY=
UNSPLASH_ACCESS_KEY=
PRESENTATIONS_AI_API_KEY=
PRESENTATIONS_AI_BASE_URL=https://api.presenton.ai
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# In production, set this to your Render backend URL, e.g.
# https://ventureforge-backend.onrender.com/api/auth/google/callback
# (and add the same URL as an authorized redirect URI in Google Cloud Console)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# In production, set this to your deployed Vercel URL, e.g.
# https://ventureforge.vercel.app
FRONTEND_URL=http://localhost:3000

SESSION_SECRET=change-me-in-production

# In production, set this to your exact Vercel URL (comma-separate for
# multiple). Must NOT be "*" — cross-domain cookies require an explicit
# origin, not a wildcard.
ALLOWED_ORIGINS=http://localhost:3000

# "production" enables Secure, SameSite=None session cookies required for
# the cross-domain Vercel <-> Render setup. Keep "development" locally.
APP_ENV=development
